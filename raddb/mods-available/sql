#
#	SQL module configuration — rlm_sql_postgresql -> Supabase
#
#	Connection parameters are read from environment variables
#	set in docker-compose.yml.
#

sql {
	driver = "rlm_sql_postgresql"

	dialect = "postgresql"

	server = "${ENV:RADIUS_SQL_SERVER}"
	port = "${ENV:RADIUS_SQL_PORT}"
	login = "${ENV:RADIUS_SQL_LOGIN}"
	password = "${ENV:RADIUS_SQL_PASSWORD}"
	radius_db = "${ENV:RADIUS_SQL_DATABASE}"

	acct_table1 = "radacct"
	acct_table2 = "radacct"
	postauth_table = "radpostauth"
	authcheck_table = "radcheck"
	groupcheck_table = "radgroupcheck"
	authreply_table = "radreply"
	groupreply_table = "radgroupreply"
	usergroup_table = "radusergroup"

	delete_stale_sessions = yes

	pool {
		start = 1
		min = 1
		max = 4
		spare = 1
		uses = 0
		retry_delay = 30
		lifetime = 0
		idle_timeout = 60
	}

	read_clients = no

	client_table = "nas"

	group_attribute = "SQL-Group"

	$INCLUDE ${modconfdir}/sql/main/${dialect}/queries.conf
}
